set working-directory := ".."
# A recipe evaluates only the variables it uses, so a task that needs no edition, Python or output name runs
# without them.
set lazy

# The edition's identity comes from git, read once here for every compile, test and archive: a checkout at the
# commit that the signed tag v<VERSION> names, with no tracked file changed, is that version's edition dated by its
# tag; any other build is a draft, named and dated by its commit: a draft of the version, or, once that version
# is tagged elsewhere, a draft after it. No date is written by hand.
edition_inputs := ```
    version=$(tr -d '[:space:]' < VERSION)
    if [ "$(git tag --points-at HEAD --list "v$version")" = "v$version" ] && git diff --quiet HEAD; then
        echo "--input edition=release --input date=$(git for-each-ref --format='%(taggerdate:short)' "refs/tags/v$version")"
    else
        changed=false; git diff --quiet HEAD || changed=true
        released=false; git rev-parse --quiet --verify "refs/tags/v$version" >/dev/null && released=true
        echo "--input edition=draft --input released=$released --input commit=$(git rev-parse --short=7 HEAD) --input changed=$changed --input date=$(git show -s --format=%cs HEAD)"
    fi
```

# The Python line, as the Mise configuration declares it; every Python command here runs on it.
python_line := `mise config get -f .config/mise/config.toml tools.python`
python := "python" + python_line

# The locked test environment on that line; it never builds a package or downloads a Python.
uv_environment := "--locked --no-build --no-python-downloads --python " + python
# The tests, as the proof runs them.
pytest := "uv run --offline " + uv_environment + " python -m pytest --config-file .config/checks/pytest/pytest.toml --rootdir . tests"
# The PDF inspection supply, which Homebrew Bundle owns.
brewfile := "publication/brewfile"

# The repository's name, which names its outputs and the runner's supply folder.
project := "rethinking-work"
# The build's outputs, named once; the tests and the Forge jobs read the folders they lie in.
pdf := "build/artifacts/pdf/" + project + ".pdf"
archive := "build/artifacts/edition/" + project + "-" + trim(read("VERSION")) + ".tgz"

default:
    @just --justfile publication/justfile --list

# Inspect existing supply without installing or changing its owner.
bootstrap: pdf-tools-check
    typst --version
    just --version
    prettier --version
    {{python}} --version

# Require the declared, already-installed PDF supply; never install or upgrade.
_pdf-tools-installed:
    env -u HOMEBREW_BUNDLE_CHECK HOMEBREW_NO_AUTO_UPDATE=1 brew bundle check --file {{brewfile}} --no-upgrade --quiet

# Only PDF inspection enters Brew's environment; other executors keep their owner.
[positional-arguments]
pdf-tool +arguments: _pdf-tools-installed
    env -u HOMEBREW_BUNDLE_SERVICES -u HOMEBREW_BUNDLE_CHECK HOMEBREW_NO_AUTO_UPDATE=1 brew bundle exec --file {{brewfile}} -- "$@"

pdf-tools-check: (pdf-tool "pdfinfo" "-v") (pdf-tool "pdftotext" "-v")

# Build only; this command grants no editorial approval or publication.
pdf:
    mkdir -p "{{parent_directory(pdf)}}"
    typst compile --root . {{edition_inputs}} --deps "{{parent_directory(pdf)}}/inputs.json" book/main.typ "{{pdf}}"

build: pdf

# Native per-page previews used by visual review.
render:
    mkdir -p build/artifacts/pages
    typst compile --root . --format png --ppi 144 book/main.typ build/artifacts/pages/page-{0p}.png

# The tests, run as the proof runs them, without its reports.
test: pdf-tools-check
    {{pytest}}

# The same unittest cases, with native same-attempt test and subprocess coverage reports.
test-proof output: pdf-tools-check
    mkdir -p "{{output}}"
    env COVERAGE_FILE="{{output}}/.coverage" {{pytest}} --junitxml="{{output}}/tests.xml" --report-log="{{output}}/pytest.jsonl" --cov --cov-config .config/checks/coverage/coverage.toml --cov-report="xml:{{output}}/coverage.xml"

# Run only the synthetic companion contracts, by the command that the book and the pack's note print (`book-check` in
# book/metadata.typ); no PDF is required.
[script]
exercises:
    #!/usr/bin/env bash
    set -euo pipefail
    command=$(typst eval --root . 'import "/book/metadata.typ": book-check; book-check' --format json | {{python}} -c 'import json, sys; print(json.load(sys.stdin))')
    eval "$command"

# One edition archive: the PDF, the tracked teaching inputs and a checksum list, in one folder whose names and
# reader notes are filled from the edition's declared facts (book/metadata.typ), its commit and the number of
# exercise checks. A gzipped tar, the format of the owner's other repositories: entries sorted, dated to the
# edition, owned by no host user, without extended attributes, and names beyond ASCII in pax headers as UTF-8, so
# a rebuild of one commit gives the same bytes.
[script]
edition-archive:
    #!/usr/bin/env bash
    set -euo pipefail
    export TZ=UTC
    pdf="{{pdf}}"
    test -f "$pdf" || { echo "No PDF at $pdf: build it first." >&2; exit 1; }
    # The edition's declared facts, read once as shell variables; a failed evaluation stops the task here.
    facts=$(typst eval --root . {{edition_inputs}} 'import "/book/metadata.typ": *; (edition: book-edition, stamp: book-date.display("[year][month][day]") + "0000", title: book-title, author: book-author, file: book-pdf, pack: book-pack, note: book-note, sums: book-sums, companion: book-companion, tools: book-pack-tools, tests: book-checks, check: book-check)' --format json | {{python}} -c 'import json, shlex, sys; print("\n".join(f"{k}={shlex.quote(v)}" for k, v in json.load(sys.stdin).items()))')
    eval "$facts"
    commit=$(git rev-parse HEAD)
    checks=$(grep -c '^    def test_' "$tests")
    work=build/runtime/work/edition-archive
    rm -rf "$work"; mkdir -p "$work" "{{parent_directory(archive)}}"
    trap 'rm -r "$work"' EXIT
    folder="$work/$title"
    mkdir -p "$folder/$pack"
    git ls-files -z VERSION LICENSE exercises "$tests" | tar --null -T - -cf - | tar -xf - -C "$folder/$pack"
    fill() {
        sed -e "s|@TITLE@|$title|g" -e "s|@AUTHOR@|$author|g" -e "s|@EDITION@|$edition|g" -e "s|@COMMIT@|$commit|g" \
            -e "s|@PDF@|$file|g" -e "s|@PACK_NAME@|$pack|g" -e "s|@NOTE@|$note|g" -e "s|@SUMS@|$sums|g" \
            -e "s|@COMPANION@|$companion|g" -e "s|@TOOLS@|$tools|g" -e "s|@CHECK@|$check|g" -e "s|@CHECKS@|$checks|g" \
            "$1" > "$2"
        ! grep -q '@[A-Z_]*@' "$2"
    }
    fill publication/notes/reader-start.zh.txt "$folder/$pack/$note"
    fill publication/notes/archive-start.zh.txt "$folder/$note"
    cp "$pdf" "$folder/$file"
    (cd "$folder" && find . -type f ! -name "$sums" | sed 's|^\./||' | LC_ALL=C sort | tr '\n' '\0' | xargs -0 shasum --algorithm 256 > "$sums")
    find "$work" -type f -exec chmod 644 {} +
    find "$work" -type d -exec chmod 755 {} +
    find "$work" -exec touch -t "$stamp" {} +
    archive="{{archive}}"
    rm -f "{{parent_directory(archive)}}"/*.tgz
    (cd "$work" && find "$title" | LC_ALL=C sort) | COPYFILE_DISABLE=1 tar --create --gzip --file "$archive" --directory "$work" --no-recursion --files-from - --uid 0 --gid 0 --uname '' --gname '' --no-xattrs --no-acls --no-fflags --no-mac-metadata --options gzip:!timestamp

# Prettier with the repository's own configuration and inputs.
prettier := "prettier --config .config/checks/prettier/prettier.toml --ignore-path .config/checks/prettier/prettierignore"

format-check:
    {{prettier}} --check .

format:
    {{prettier}} --write .

# The book's decided wording and decidable punctuation (the book style in .config/checks/vale):
# the rules' own cases first, then the rules over book/. A host's own Vale configuration is not loaded.
prose-check:
    vale --no-global --config .config/checks/vale/vale.ini test .config/checks/vale --coverage
    vale --no-global --config .config/checks/vale/vale.ini book/

check: format-check prose-check test

# Build the PDF and the edition archive and print their identities, as a Forge job keeps them.
ci-artifacts: build edition-archive
    git diff --exit-code -- .config/mise
    shasum --algorithm 256 "{{pdf}}" "{{archive}}"

# The locked test environment, on the declared Python line.
test-env:
    uv sync {{uv_environment}}

# Where a CI runner's account keeps the faces for later jobs: in its cache folder, outside the checkout, whose ignored
# files the GitLab runner removes when each job starts. Every task names it to Typst after any font paths the caller
# set, through Typst's own setting, so nothing is written into the account's font folder; on a host without this
# folder Typst reads the caller's font paths and the system's fonts as before.
supply_fonts := cache_directory() / project / "fonts"
export TYPST_FONT_PATHS := if env("TYPST_FONT_PATHS", "") == "" { supply_fonts } else { env("TYPST_FONT_PATHS") + PATH_VAR_SEP + supply_fonts }
# How the supply downloads: over HTTPS only, redirects included, failing on an HTTP error, and giving up when no
# connection opens within 15 seconds; each download sets how long it may take.
fetch := "curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --connect-timeout 15"

# Supply a CI runner's account with fonts, Typst packages, tests and PDF tools.
# Present supply that matches the manifests is kept; only missing or changed supply is fetched.
[script]
ci-supply:
    #!/usr/bin/env bash
    set -euo pipefail
    export HOMEBREW_NO_AUTO_UPDATE=1
    manifests="$PWD/publication/supply"
    work=build/runtime/work/ci-supply
    rm -rf "$work"
    fonts="{{supply_fonts}}"
    mkdir -p "$work" "$fonts"
    # The faces, the archive's place and its source, each as its manifest states it.
    faces=$(awk '{print $2}' "$manifests/noto-faces.sha256")
    download=$(awk '{print $2}' "$manifests/ci-noto.sha256")
    faces_match() {
        [ -n "$faces" ] || return 1
        for face in $faces; do
            expected=$(awk -v f="$face" '$2 == f {print $1}' "$manifests/noto-faces.sha256")
            actual=$(shasum --algorithm 256 "$fonts/$(basename "$face")" 2>/dev/null | cut -d ' ' -f 1 || true)
            [ "$expected" = "$actual" ] || return 1
        done
    }
    if faces_match; then
        echo "Noto faces: present"
    else
        mkdir -p "$(dirname "$download")"
        {{fetch}} --max-time 600 --output "$download" "$(cat "$manifests/noto.url")"
        shasum --algorithm 256 --check "$manifests/ci-noto.sha256"
        unzip -q "$download" -d "$work/noto"
        for face in $faces; do
            cp "$work/noto/$(basename "$face")" "$fonts/"
        done
        faces_match
        echo "Noto faces: installed"
    fi
    # Typst's package cache, as the compiler reports it; the manifest lists each file relative to it.
    cache=$(typst info --format json | {{python}} -c 'import json, sys; print(json.load(sys.stdin)["packages"]["package-cache-path"] or sys.exit("typst info reports no package cache"))')
    if (cd "$cache" 2>/dev/null && shasum --algorithm 256 --check --quiet --status "$manifests/typst-packages.sha256"); then
        echo "Typst packages: present"
    else
        # Each package root the manifest lists, as namespace/name/version, from the official registry.
        for package in $(awk '{print $2}' "$manifests/typst-packages.sha256" | cut -d / -f 1-3 | sort -u); do
            name="${package#*/}"
            archive="$work/${name/\//-}.tar.gz"
            {{fetch}} --max-time 90 --output "$archive" "https://packages.typst.org/${package%%/*}/${name/\//-}.tar.gz"
            rm -rf "$cache/$package"
            mkdir -p "$cache/$package"
            tar -xzf "$archive" -C "$cache/$package"
        done
        (cd "$cache" && shasum --algorithm 256 --check --quiet "$manifests/typst-packages.sha256")
        echo "Typst packages: installed"
    fi
    just --justfile publication/justfile test-env
    if just --quiet --justfile publication/justfile _pdf-tools-installed; then
        echo "PDF tools: present"
    else
        brew bundle install --file {{brewfile}} --no-upgrade
    fi
    rm -rf "$work"
