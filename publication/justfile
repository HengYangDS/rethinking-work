set working-directory := ".."

# The headless shell that the locked Mermaid CLI expects, declared once here; `ci-supply` installs
# this build in Puppeteer's own cache layout and checks it against the supply manifest.
# A CI runner's launch context can stop Google Chrome at start.
headless_shell_version := "156.0.8078.47"
headless_shell := home_directory() / ".cache/puppeteer/chrome-headless-shell/mac_arm-" + headless_shell_version + "/chrome-headless-shell-mac-arm64/chrome-headless-shell"

# Mermaid drives this browser in every recipe, whatever shell or tool started `just`: the headless
# shell where installed, otherwise Google Chrome. A caller may name another one.
export PUPPETEER_EXECUTABLE_PATH := env("PUPPETEER_EXECUTABLE_PATH", if path_exists(headless_shell) == "true" { headless_shell } else { "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" })

default:
    @just --justfile publication/justfile --list

# Inspect existing supply without installing or changing its owner.
bootstrap: pdf-tools-check
    typst --version
    mmdc --version
    just --version
    prettier --version
    python3.12 --version

# Require the declared, already-installed PDF supply; never install or upgrade.
_pdf-tools-installed:
    env -u HOMEBREW_BUNDLE_CHECK HOMEBREW_NO_AUTO_UPDATE=1 brew bundle check --file publication/brewfile --no-upgrade --quiet

# Only PDF inspection enters Brew's environment; other executors keep their owner.
[positional-arguments]
pdf-tool +arguments: _pdf-tools-installed
    env -u HOMEBREW_BUNDLE_SERVICES -u HOMEBREW_BUNDLE_CHECK HOMEBREW_NO_AUTO_UPDATE=1 brew bundle exec --file publication/brewfile -- "$@"

pdf-tools-check: (pdf-tool "pdfinfo" "-v") (pdf-tool "pdftotext" "-v")

# Render one editable figure through the installed Mermaid CLI.
diagram name format="png":
    @test -x "$PUPPETEER_EXECUTABLE_PATH" || { echo "No browser for Mermaid at $PUPPETEER_EXECUTABLE_PATH: run ci-supply for the headless shell {{headless_shell_version}}, or set PUPPETEER_EXECUTABLE_PATH." >&2; exit 1; }
    mkdir -p build/artifacts/diagrams
    mmdc --input diagrams/{{name}}.mmd --output build/artifacts/diagrams/{{name}}.{{format}} --configFile publication/mermaid.json --scale 2 --backgroundColor white --puppeteerConfigFile publication/puppeteer.json || { echo "Diagram {{name}} failed to render." >&2; exit 1; }

# The renders are independent; Just runs them at once, and a failed one names itself.
[parallel]
diagrams: (diagram "collaboration") (diagram "context") (diagram "memory") (diagram "reconcile") (diagram "work-chain") (diagram "work-loop")

# Build only; this command grants no editorial approval or publication.
pdf:
    mkdir -p build/artifacts/pdf
    typst compile --root . --deps build/artifacts/pdf/inputs.json book/main.typ build/artifacts/pdf/rethinking-work.pdf

# Check the exact existing compiler, fonts and complete package inputs.
typst-input-check supply:
    cd "{{supply}}" && shasum --algorithm 256 --check "{{justfile_directory()}}/supply/typst-inputs.sha256"

# Verify the complete upstream package trees before hosted compilation.
typst-package-check supply:
    cd "{{supply}}" && shasum --algorithm 256 --check "{{justfile_directory()}}/supply/typst-packages.sha256"

# Compile current figure inputs without ambient font or package discovery.
pdf-isolated supply: (typst-input-check supply)
    mkdir -p build/artifacts/pdf-isolated
    "{{supply}}/bin/typst" compile --root . --ignore-system-fonts --font-path "{{supply}}/fonts" --package-path "{{supply}}/packages" --package-cache-path "{{supply}}/packages" --deps build/artifacts/pdf-isolated/inputs.json book/main.typ build/artifacts/pdf-isolated/rethinking-work.pdf

build: diagrams pdf

# Native per-page previews used by visual review.
render:
    mkdir -p build/artifacts/pages
    typst compile --root . --format png --ppi 144 book/main.typ build/artifacts/pages/page-{0p}.png

# Tests consume freshly rendered figures, including in a source-only checkout.
test: diagrams pdf-tools-check
    python3.12 -B -m unittest discover -s tests -v

# The same unittest cases, with native same-attempt test and subprocess coverage reports.
test-proof output: diagrams pdf-tools-check
    mkdir -p "{{output}}"
    env COVERAGE_FILE="{{output}}/.coverage" uv run --locked --offline --no-build --no-python-downloads --python python3.12 python -m pytest --config-file .config/checks/pytest/pytest.toml --rootdir . tests --junitxml="{{output}}/tests.xml" --report-log="{{output}}/pytest.jsonl" --cov --cov-config .config/checks/coverage/coverage.toml --cov-report="xml:{{output}}/coverage.xml"

# Run only the synthetic companion contracts; no PDF or browser is required.
exercises:
    python3.12 -B -m unittest discover -s tests -p test_exercises.py -v

# One edition archive: the PDF, the tracked teaching inputs and a checksum list, in one folder whose
# reader notes are filled from VERSION, the edition date and the number of exercise checks. A
# gzipped tar, the format of the owner's other repositories: entries sorted, dated to the edition,
# owned by no host user, without extended attributes, and names beyond ASCII in pax headers as
# UTF-8, so a rebuild of one commit gives the same bytes.
[script]
edition-archive:
    #!/usr/bin/env bash
    set -euo pipefail
    export TZ=UTC
    pdf=build/artifacts/pdf/rethinking-work.pdf
    test -f "$pdf" || { echo "No PDF at $pdf: build it first." >&2; exit 1; }
    version=$(tr -d '[:space:]' < VERSION)
    identity() { typst eval --root . "import \"/book/metadata.typ\": book-date, book-date-text; $1" --format json | python3.12 -c 'import json, sys; print(json.load(sys.stdin))'; }
    date_text=$(identity book-date-text)
    stamp=$(identity 'book-date.display("[year][month][day]")')0000
    commit=$(git rev-parse HEAD)
    checks=$(grep -c '^    def test_' tests/test_exercises.py)
    git diff --quiet HEAD -- VERSION LICENSE exercises tests/test_exercises.py book publication || commit="${commit}（工作区有未提交的改动）"
    work=build/runtime/work/edition-archive
    rm -rf "$work"; mkdir -p "$work" build/artifacts/edition
    trap 'rm -r "$work"' EXIT
    folder="$work/重新理解工作"
    mkdir -p "$folder/实战练习"
    git ls-files -z VERSION LICENSE exercises tests/test_exercises.py | tar --null -T - -cf - | tar -xf - -C "$folder/实战练习"
    fill() { sed -e "s|@VERSION@|$version|g" -e "s|@DATE@|$date_text|g" -e "s|@COMMIT@|$commit|g" -e "s|@CHECKS@|$checks|g" "$1" > "$2"; ! grep -q '@[A-Z]*@' "$2"; }
    fill publication/reader-start.zh.txt "$folder/实战练习/先读.txt"
    fill publication/archive-start.zh.txt "$folder/先读.txt"
    cp "$pdf" "$folder/重新理解工作-$version.pdf"
    (cd "$folder" && find . -type f ! -name SHA256SUMS | sed 's|^\./||' | LC_ALL=C sort | tr '\n' '\0' | xargs -0 shasum --algorithm 256 > SHA256SUMS)
    find "$work" -type f -exec chmod 644 {} +
    find "$work" -type d -exec chmod 755 {} +
    find "$work" -exec touch -t "$stamp" {} +
    archive="build/artifacts/edition/rethinking-work-$version.tgz"
    rm -f build/artifacts/edition/rethinking-work-*.tgz build/artifacts/edition/rethinking-work-*.zip
    (cd "$work" && find 重新理解工作 | LC_ALL=C sort) | COPYFILE_DISABLE=1 tar --create --gzip --file "$archive" --directory "$work" --no-recursion --files-from - --uid 0 --gid 0 --uname '' --gname '' --no-xattrs --no-acls --no-fflags --no-mac-metadata --options gzip:!timestamp

format-check:
    prettier --config .config/checks/prettier/prettier.toml --ignore-path .config/checks/prettier/prettierignore --check .

format:
    prettier --config .config/checks/prettier/prettier.toml --ignore-path .config/checks/prettier/prettierignore --write .

check: format-check test

# Build the PDF and the edition archive and print their identities, as a Forge job keeps them.
ci-artifacts: build edition-archive
    git diff --exit-code -- .config/mise
    shasum --algorithm 256 build/artifacts/pdf/rethinking-work.pdf build/artifacts/edition/rethinking-work-*.tgz

# The hosted macOS job first checks the supply it fetched into its own workspace.
ci-publication supply="build/runtime/ci/typst": (typst-package-check supply) ci-artifacts

# Present supply that matches the manifests is kept; only missing or changed supply is fetched.
# Supply a CI runner's account with fonts, Typst packages, headless shell, tests and PDF tools.
[script]
ci-supply:
    #!/usr/bin/env bash
    set -euo pipefail
    export HOMEBREW_NO_AUTO_UPDATE=1
    manifests="$PWD/publication/supply"
    work=build/runtime/work/ci-supply
    rm -rf "$work"
    mkdir -p "$work" build/runtime/ci/downloads "$HOME/Library/Fonts"
    faces_match() {
        for face in Regular Bold Black; do
            expected=$(awk -v f="fonts/NotoSansCJKsc-$face.otf" '$2 == f {print $1}' "$manifests/typst-inputs.sha256")
            actual=$(shasum --algorithm 256 "$HOME/Library/Fonts/rethinking-NotoSansCJKsc-$face.otf" 2>/dev/null | cut -d ' ' -f 1 || true)
            [ -n "$expected" ] && [ "$expected" = "$actual" ] || return 1
        done
    }
    if faces_match; then
        echo "Noto faces: present"
    else
        curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --connect-timeout 15 --max-time 600 --output build/runtime/ci/downloads/noto.zip https://github.com/notofonts/noto-cjk/releases/download/Sans2.004/08_NotoSansCJKsc.zip
        shasum --algorithm 256 --check publication/supply/ci-noto.sha256
        unzip -q build/runtime/ci/downloads/noto.zip -d "$work/noto"
        for face in Regular Bold Black; do
            cp "$work/noto/NotoSansCJKsc-$face.otf" "$HOME/Library/Fonts/rethinking-NotoSansCJKsc-$face.otf"
        done
        faces_match
        echo "Noto faces: installed"
    fi
    cache="$HOME/Library/Caches/typst"
    if (cd "$cache" 2>/dev/null && shasum --algorithm 256 --check --quiet --status "$manifests/typst-packages.sha256"); then
        echo "Typst packages: present"
    else
        for package in algorithmic/1.0.7 codly/2.0.0 codly-languages/0.1.10 elembic/1.1.1 neat-book/0.1.0 octique/0.1.1 showybox/2.0.4 theorion/0.6.0; do
            archive="$work/${package/\//-}.tar.gz"
            curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --connect-timeout 15 --max-time 90 --output "$archive" "https://packages.typst.org/preview/${package/\//-}.tar.gz"
            rm -rf "$cache/packages/preview/$package"
            mkdir -p "$cache/packages/preview/$package"
            tar -xzf "$archive" -C "$cache/packages/preview/$package"
        done
        (cd "$cache" && shasum --algorithm 256 --check --quiet "$manifests/typst-packages.sha256")
        echo "Typst packages: installed"
    fi
    shell="{{headless_shell}}"
    if [ -x "$shell" ] && [ "$("$shell" --version)" = "Google Chrome for Testing {{headless_shell_version}}" ]; then
        echo "Headless shell: present"
    else
        curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --connect-timeout 15 --max-time 600 --output build/runtime/ci/downloads/chrome-headless-shell-mac-arm64.zip https://storage.googleapis.com/chrome-for-testing-public/{{headless_shell_version}}/mac-arm64/chrome-headless-shell-mac-arm64.zip
        shasum --algorithm 256 --check publication/supply/ci-chrome-headless-shell.sha256
        target="${shell%/chrome-headless-shell-mac-arm64/chrome-headless-shell}"
        rm -rf "$target"
        mkdir -p "$target"
        unzip -q build/runtime/ci/downloads/chrome-headless-shell-mac-arm64.zip -d "$target"
        "$shell" --version
        echo "Headless shell: installed"
    fi
    uv sync --locked --no-python-downloads --python python3.12
    if env -u HOMEBREW_BUNDLE_CHECK brew bundle check --file publication/brewfile --no-upgrade --quiet; then
        echo "PDF tools: present"
    else
        brew bundle install --file publication/brewfile --no-upgrade
    fi
    rm -rf "$work"
