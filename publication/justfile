set working-directory := ".."

default:
    @just --justfile publication/justfile --list

# Inspect existing supply without installing or changing its owner.
bootstrap: pdf-tools-check
    typst --version
    mmdc --version
    just --version
    prettier --version
    python3.12 --version

# Require the declared, already-installed PDF supply; never install or upgrade.
_pdf-tools-installed:
    env -u HOMEBREW_BUNDLE_CHECK HOMEBREW_NO_AUTO_UPDATE=1 brew bundle check --file publication/brewfile --no-upgrade --quiet

# Only PDF inspection enters Brew's environment; other executors keep their owner.
[positional-arguments]
pdf-tool +arguments: _pdf-tools-installed
    env -u HOMEBREW_BUNDLE_SERVICES -u HOMEBREW_BUNDLE_CHECK HOMEBREW_NO_AUTO_UPDATE=1 brew bundle exec --file publication/brewfile -- "$@"

pdf-tools-check: (pdf-tool "pdfinfo" "-v") (pdf-tool "pdftotext" "-v")

# Render one editable figure through the installed Mermaid CLI.
diagram name format="png":
    mkdir -p build/artifacts/diagrams
    mmdc --input diagrams/{{name}}.mmd --output build/artifacts/diagrams/{{name}}.{{format}} --configFile publication/mermaid.json --scale 2 --backgroundColor white --puppeteerConfigFile publication/puppeteer.json

diagrams: (diagram "collaboration") (diagram "data-chain") (diagram "memory") (diagram "orchestration") (diagram "reconcile") (diagram "runtime") (diagram "work-loop")

# Build only; this command grants no editorial approval or publication.
pdf:
    mkdir -p build/artifacts/pdf
    typst compile --root . --deps build/artifacts/pdf/inputs.json book/main.typ build/artifacts/pdf/rethinking-work.pdf

# Check the exact existing compiler, fonts and complete package inputs.
typst-input-check supply:
    cd "{{supply}}" && shasum --algorithm 256 --check "{{justfile_directory()}}/supply/typst-inputs.sha256"

# Compile current figure inputs without ambient font or package discovery.
pdf-isolated supply: (typst-input-check supply)
    mkdir -p build/artifacts/pdf-isolated
    "{{supply}}/bin/typst" compile --root . --ignore-system-fonts --font-path "{{supply}}/fonts" --package-path "{{supply}}/packages" --package-cache-path "{{supply}}/packages" --deps build/artifacts/pdf-isolated/inputs.json book/main.typ build/artifacts/pdf-isolated/rethinking-work.pdf

build: diagrams pdf

# Native per-page previews used by visual review.
render:
    mkdir -p build/artifacts/pages
    typst compile --root . --format png --ppi 144 book/main.typ build/artifacts/pages/page-{0p}.png

# Tests consume freshly rendered figures, including in a source-only checkout.
test: diagrams pdf-tools-check
    python3.12 -B -m unittest discover -s tests -v

# The same unittest cases, with native same-attempt test and subprocess coverage reports.
test-proof output: diagrams pdf-tools-check
    mkdir -p "{{output}}"
    env COVERAGE_FILE="{{output}}/.coverage" uv run --locked --offline --no-build --no-python-downloads --python python3.12 python -m pytest --config-file .config/checks/pytest/pytest.toml --rootdir . tests --junitxml="{{output}}/tests.xml" --report-log="{{output}}/pytest.jsonl" --cov --cov-config .config/checks/coverage/coverage.toml --cov-report="xml:{{output}}/coverage.xml"

# Run only the synthetic companion contracts; no PDF or browser is required.
exercises:
    python3.12 -B -m unittest discover -s tests -p test_exercises.py -v

format-check:
    prettier --config .config/checks/prettier/prettier.toml --ignore-path .config/checks/prettier/prettierignore --check .

format:
    prettier --config .config/checks/prettier/prettier.toml --ignore-path .config/checks/prettier/prettierignore --write .

check: format-check test

# Generate both native peer documents from the shared CUE owner.
ci-generate:
    cue export .config/ci/pipeline.cue -e compiled.github.document --out yaml --outfile .github/workflows/verify.yml --force
    cue export .config/ci/pipeline.cue -e compiled.gitlab.document --out yaml --outfile .gitlab-ci.yml --force
    prettier --config .config/checks/prettier/prettier.toml --ignore-path .config/checks/prettier/prettierignore --write .github/workflows/verify.yml .gitlab-ci.yml

ci-projections:
    cue vet -c .config/ci/pipeline.cue .github/workflows/verify.yml -d compiled.github.document
    cue vet -c .config/ci/pipeline.cue .gitlab-ci.yml -d compiled.gitlab.document

# Bind the native job to its declared platform and exact event commit.
ci-identity platform commit:
    test "{{os()}}:{{arch()}}" = "{{platform}}"
    test "{{`git rev-parse HEAD`}}" = "{{commit}}"

# Source CI is deliberately separate from the complete PDF qualification.
ci: ci-projections format-check exercises
