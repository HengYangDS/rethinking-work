# Normalize authored text without treating generated or binary files as text.
* text=auto eol=lf
# Reader fixtures retain their documentation role; runnable Python examples
# and their regression tests have native code and test responsibilities.
exercises/** ethos-role=docs
exercises/cases/export-regression/export_bug.py ethos-role=code
exercises/cases/export-regression/export_fixed.py ethos-role=code
exercises/cases/export-regression/test_export.py ethos-role=test
